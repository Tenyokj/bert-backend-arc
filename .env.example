# Arc / BERT contract configuration
RPC_URL=https://<arc-testnet-rpc>
BERT_CHAIN_ID=<arc_testnet_chain_id>
POP_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
POP_SIGNER_PRIVATE_KEY=0x<64_hex_characters>
POP_VERIFICATION_WINDOW_SECONDS=1209600
POP_PROVIDER_ID=WORLD_ID

# World ID relying-party configuration
WORLD_APP_ID=app_<your_world_app_id>
WORLD_RP_ID=<your_world_rp_id>
WORLD_RP_SIGNING_KEY=0x<64_hex_characters>
WORLD_ACTION=bert-vote-human-verification
WORLD_ENVIRONMENT=staging

# Browser origin allowed by the API. Use the deployed URL in Vercel.
CORS_ORIGIN=http://localhost:3000

# `memory` is local development only. Use Upstash Redis REST on Vercel.
NULLIFIER_STORE_MODE=memory
NULLIFIER_STORE_REDIS_REST_URL=
NULLIFIER_STORE_REDIS_REST_TOKEN=
